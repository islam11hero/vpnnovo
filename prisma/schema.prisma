// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(uuid())
  amount    Float
  status    String   @default("PENDING")
  subUrl    String?
  createdAt DateTime @default(now())
}

/// Anti-abuse vault: one trial per IP or device fingerprint.
model TrialLog {
  id          String   @id @default(uuid())
  ipAddress   String
  deviceHash  String
  orderId     String?
  createdAt   DateTime @default(now())

  @@index([ipAddress])
  @@index([deviceHash])
}
