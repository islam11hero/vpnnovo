# =============================================================================
# IPNOVA — Vercel Production Environment Variables
# Copy to Vercel → Project → Settings → Environment Variables (Production + Preview)
# =============================================================================

# --- Public site ---
NEXT_PUBLIC_SITE_URL="https://www.nordvp.online"

# --- Client support (portal Support tab + footer) ---
NEXT_PUBLIC_SUPPORT_EMAIL="support@nordvp.online"
# Telegram username or full URL, e.g. "your_handle" or "https://t.me/your_handle"
NEXT_PUBLIC_SUPPORT_TELEGRAM=""

# --- Supabase (required for checkout, portal, trials) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# CRITICAL: Service role — server-only, never expose to client bundles
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --- Marzban VPN panel (http or https URL — no trailing slash) ---
MARZBAN_API_URL="https://api.ipnova.com"
MARZBAN_USERNAME="admin"
MARZBAN_PASSWORD="your-marzban-password"
# Must match the inbound tag in Marzban Panel → Host Settings (default: VLESS TCP REALITY)
MARZBAN_VLESS_INBOUND="VLESS TCP REALITY"
# Marzban client uses axios + rejectUnauthorized:false for IP/self-signed panels (server-side only)

# --- Admin Command Center ---
ADMIN_SECRET="your-strong-admin-password-min-32-chars"

# --- Prisma (optional legacy — trial anti-abuse now uses Supabase trial_logs) ---
# DATABASE_URL="file:./dev.db"

# --- Stripe (optional — GCC/China Payment Links only; primary checkout is crypto) ---
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Payment Link success URL: https://YOUR_DOMAIN/checkout/stripe-success?session_id={CHECKOUT_SESSION_ID}
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe (event: checkout.session.completed)

# --- NOWPayments (primary checkout) ---
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
NOWPAYMENTS_IPN_SECRET="your-ipn-secret-from-dashboard"

# --- Vultr (optional — leave unset; NOC uses Marzban + Supabase) ---
# VULTR_API_KEY=""
# VULTR_INSTANCE_ID=""

# --- Optional: legacy crypto webhook (disabled unless set) ---
# CRYPTO_WEBHOOK_SECRET=""
