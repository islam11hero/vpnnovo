# Database (Prisma / SQLite)
DATABASE_URL="file:./dev.db"

# Marzban panel API
MARZBAN_API_URL="https://your-marzban-panel.example"
MARZBAN_USERNAME="admin"
MARZBAN_PASSWORD="your-marzban-password"

# Admin dashboard password (sets HttpOnly admin_session cookie on login)
ADMIN_SECRET="your-strong-admin-password"

# Supabase (billing & orders — Phase 5 foundation)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public site URL (no trailing slash) — used for NOWPayments callbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NOWPayments
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
NOWPAYMENTS_IPN_SECRET="your-ipn-secret-from-dashboard"
